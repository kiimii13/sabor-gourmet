    {
      "name": "2. Mesas",
      "item": [
        {
          "name": "Listar mesas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tables"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const tables = pm.response.json();",
                  "",
                  "// Busca una mesa sin reservas para poder eliminarla y dejar cupo libre",
                  "const baseUrl = pm.variables.get(\"baseUrl\");",
                  "const usedTables = new Set();",
                  "function readReservation(id) {",
                  "    pm.sendRequest(baseUrl + \"/reservations/\" + id, function (err, res) {",
                  "        if (!err && res.code === 200 && id < 500) {",
                  "            usedTables.add(res.json().tableId);",
                  "            readReservation(id + 1);",
                  "            return;",
                  "        }",
                  "        const free = tables",
                  "            .filter(t => !usedTables.has(t.id))",
                  "            .sort((a, b) => b.id - a.id)[0];",
                  "        pm.test(\"Existe una mesa sin reservas para eliminar\", function () {",
                  "            pm.expect(free).to.not.be.undefined;",
                  "        });",
                  "        if (free) {",
                  "            pm.collectionVariables.set(\"tableDeleteId\", String(free.id));",
                  "        }",
                  "    });",
                  "}",
                  "readReservation(1);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Eliminar mesa sin reservas",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/tables/{{tableDeleteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
